# AI Automation Configuration
# Environment variables for BRD to Test Automation

# LiteLLM API Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=anything
LITELLM_PRIMARY_MODEL=qwen3
LITELLM_STRONG_MODEL=qwen3
LITELLM_TEMPERATURE=0.0
LITELLM_MAX_TOKENS=2048
LITELLM_TIMEOUT_S=120

# Output Directories
OUTPUT_FEATURE_DIR=outputs/features
OUTPUT_TEST_DIR=outputs/tests

# FastAPI Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_DIR=logs
LOG_FILE_PREFIX=ai-automation
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=14

# Ollama (used inside Docker to pull the model)
OLLAMA_MODEL=qwen2.5:latest
